# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (web).
# Leave VITE_FIREBASE_API_KEY empty to use the local emulators (npm run emulators).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force the emulators even when a project is configured.
VITE_USE_FIREBASE_EMULATORS=false
